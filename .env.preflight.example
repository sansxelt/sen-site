# Vraelis Preflight — server-only env for the Railway worker (and the discovery/run APIs).
# NEVER expose any of these via NEXT_PUBLIC_. Copy the values into the Railway service (and the web app
# where the run/discovery APIs need them). Do not commit real values.

# ── Browser provider (isolated cloud browser) ──
BROWSER_PROVIDER=browserbase           # browserbase | fake  (fake = deterministic, for lifecycle tests)
BROWSERBASE_API_KEY=                    # required when BROWSER_PROVIDER=browserbase; the project is inferred from the key (worker fails fast if missing)

# ── Shared data plane (the queue + evidence live in the existing Supabase) ──
NEXT_PUBLIC_SUPABASE_URL=               # already set for the app; the worker reuses it
SUPABASE_SERVICE_ROLE_KEY=              # service role (BYPASSRLS); server-only

# ── Worker identity + lifecycle bounds ──
PREFLIGHT_WORKER_ID=                    # optional; a stable random id is generated when absent
PREFLIGHT_WORKER_POLL_MS=2000
PREFLIGHT_WORKER_LEASE_SECONDS=90
PREFLIGHT_WORKER_HEARTBEAT_SECONDS=20
PREFLIGHT_SHUTDOWN_GRACE_MS=30000

# ── Per-run safety caps ──
PREFLIGHT_MAX_RUN_SECONDS=900
PREFLIGHT_MAX_FLOW_SECONDS=180
PREFLIGHT_MAX_STEPS_PER_FLOW=30
PREFLIGHT_MAX_CONCURRENT_RUNS=1

# ── Web-app feature flags (server-only route access + client nav visibility) ──
VRAELIS_PREFLIGHT_INTERNAL_ONLY=1       # internal-only during development
# NEXT_PUBLIC_VRAELIS_PREFLIGHT=1       # shows the Applications nav item to internal testers
