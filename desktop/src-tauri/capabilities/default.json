{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability — applies to splash + main windows",
  "windows": ["main", "splash"],
  "permissions": [
    "core:default",
    "opener:default",
    "deep-link:default",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://sansxel.ai/*" },
        { "url": "http://localhost:3000/*" },
        { "url": "http://127.0.0.1:3000/*" }
      ]
    }
  ]
}
