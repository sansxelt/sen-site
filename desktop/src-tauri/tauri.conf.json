{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sansxel",
  "version": "0.1.11",
  "identifier": "ai.sansxel.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "url": "splash.html",
        "title": "sansxel",
        "width": 720,
        "height": 420,
        "decorations": false,
        "resizable": false,
        "center": true,
        "skipTaskbar": true,
        "visible": true,
        "alwaysOnTop": true,
        "focus": true,
        "backgroundColor": "#050505"
      },
      {
        "label": "main",
        "url": "index.html",
        "title": "sansxel",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#050505"
      },
      {
        "label": "copilot",
        "url": "copilot.html",
        "title": "sansxel copilot",
        "width": 12,
        "height": 600,
        "minWidth": 12,
        "minHeight": 200,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "sansxel",
    "copyright": "© sansxel",
    "category": "Productivity",
    "shortDescription": "sansxel",
    "longDescription": "sansxel — your personal AI workspace.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["sansxel"]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://sansxel.ai/api/desktop/updates/latest?platform={{target}}-{{arch}}&version={{current_version}}"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwQkVDQkNGMDUwOEQ3RTIKUldUaTF3Z0Z6OHUrWUVWQ29XSlVxZzZZTUNuWWlVTGs1TnQvUEl6M1BleTMwTXlIVGFEREFRV2wK"
    }
  }
}
