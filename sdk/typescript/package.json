{
  "name": "@vraelis/sdk",
  "version": "0.3.0",
  "description": "Official TypeScript SDK for Vraelis: check what a coding agent says it built on the deployed app, in a real browser, and get back verified, failed or blocked with evidence.",
  "private": true,
  "license": "MIT",
  "author": "Vraelis",
  "homepage": "https://vraelis.com/developers",
  "repository": { "type": "git", "url": "git+https://github.com/sansxelt/sen-site.git", "directory": "sdk/typescript" },
  "bugs": { "url": "https://vraelis.com/developers" },
  "keywords": ["vraelis", "verification", "coding agents", "ai agents", "deployment", "end-to-end testing", "browser testing", "webhooks", "typescript"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:exports": "node scripts/smoke.mjs",
    "test:runtime": "node scripts/smoke.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8",
    "typescript": "^5"
  },
  "publishConfig": { "access": "restricted" }
}
