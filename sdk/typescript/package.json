    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["vraelis", "human-evaluation", "decision-package", "ab-testing", "creative"],
  "engines": { "node": ">=18" },
