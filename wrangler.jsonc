// Cloudflare Worker config for the OpenNext-built Next.js app.
// `@opennextjs/cloudflare build` emits .open-next/worker.js + a
// matching assets dir, then `@opennextjs/cloudflare deploy` calls
// wrangler under the hood and reads this file for the Worker name,
// entry point, and asset binding.
//
// nodejs_compat is required: Next 16 / React 19 server runtime
// pulls in node:* modules (Buffer, crypto, util) that aren't in
// the default Workers runtime.
//
// Add KV/D1/R2 bindings here later if/when we move incremental
// cache, ISR cache, or media off Supabase. v1 is stateless on
// Cloudflare and stores everything in Supabase via fetch.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sansxel-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  }
}
