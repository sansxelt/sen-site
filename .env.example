AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=https://www.sansxel.ai
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret
AUTH_GITHUB_ID=replace-with-github-client-id
AUTH_GITHUB_SECRET=replace-with-github-client-secret
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
RESEND_API_KEY=re_replace-with-resend-api-key
RESEND_FROM_EMAIL=sansxel <hello@sansxel.app>

# Stripe — get these from dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-webhook-signing-secret
# Publishable key is safe to expose — used by the browser to render Stripe Payment Element
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace-with-stripe-publishable-key
# Each paid plan needs two prices in Stripe: one monthly, one yearly
# Teams prices are per-seat (Stripe handles quantity)
# Individual plans only — Teams + Enterprise go via /contact
STRIPE_PRICE_APPRENTICE_MONTHLY=price_replace
STRIPE_PRICE_APPRENTICE_YEARLY=price_replace
STRIPE_PRICE_STUDIO_MONTHLY=price_replace
STRIPE_PRICE_STUDIO_YEARLY=price_replace
STRIPE_PRICE_PRO_MONTHLY=price_replace
STRIPE_PRICE_PRO_YEARLY=price_replace
# Addon prices (optional — each addon needs monthly + yearly)
STRIPE_PRICE_MEMORY_BOOST_MONTHLY=price_replace
STRIPE_PRICE_MEMORY_BOOST_YEARLY=price_replace
STRIPE_PRICE_API_BOOST_MONTHLY=price_replace
STRIPE_PRICE_API_BOOST_YEARLY=price_replace
STRIPE_PRICE_KEY_PACK_MONTHLY=price_replace
STRIPE_PRICE_KEY_PACK_YEARLY=price_replace
