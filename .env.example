# Vraelis (Rank) — environment. Copy to .env.local for dev, or set in Vercel for prod.
# Values below are placeholders. Anything commented out is optional.

# ── Auth (NextAuth) ──────────────────────────────────────────────
AUTH_SECRET=replace-with-a-long-random-secret          # e.g. `openssl rand -base64 33`
AUTH_URL=https://vraelis.com                           # apex, matches the canonical host
# AUTH_COOKIE_DOMAIN=.vraelis.com                      # optional, for cross-subdomain sessions
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret
AUTH_GITHUB_ID=replace-with-github-client-id
AUTH_GITHUB_SECRET=replace-with-github-client-secret

# ── Connection OAuth ─────────────────────────────────────────────
# Lets a user authorize a provider (on the provider's own site) so Vraelis holds a read-only token for
# their app. SEPARATE OAuth apps from sign-in above: different callback URLs, read-only scopes. The token
# is sealed with VRAELIS_SECRET_KEY (AES-256-GCM). GitHub is live (Phase 1); the rest ship as their
# consumers are wired. Register each app's callback as https://vraelis.com/api/preflight/apps/oauth/callback/<provider>
# All connection-OAuth apps register the SAME callback URL:
#   https://vraelis.com/api/preflight/apps/oauth/callback/<provider>
# (one URL serves both the account-level and per-app flows). Each provider lights up when its creds are set.
GITHUB_CONNECT_CLIENT_ID=replace-with-a-SEPARATE-github-oauth-app-client-id       # NOT AUTH_GITHUB_ID (that's sign-in)
GITHUB_CONNECT_CLIENT_SECRET=replace-with-that-github-oauth-app-client-secret
# Vercel — create a Vercel Integration; scopes set on the integration (read projects + deployments).
VERCEL_CLIENT_ID=          VERCEL_CLIENT_SECRET=
# Sentry — create a Sentry Integration; short-lived tokens (~8h) that auto-refresh.
SENTRY_CLIENT_ID=          SENTRY_CLIENT_SECRET=
# Stripe — Connect (Standard) read-only. Reuses STRIPE_SECRET_KEY as the exchange secret (no new secret).
STRIPE_CONNECT_CLIENT_ID=  # ca_... from Stripe Connect settings
# Supabase — GATED: its OAuth scope grants management-API access, broader than the "no DB credentials"
# promise. Stays off until SUPABASE_OAUTH_ENABLED=1 AND the NEVER_ACCESSES.supabase copy is rewritten.
# SUPABASE_OAUTH_CLIENT_ID=  SUPABASE_OAUTH_CLIENT_SECRET=  SUPABASE_OAUTH_ENABLED=1

# ── Database (Supabase) ──────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key   # server-only; bypasses RLS

# ── AI evaluator (the check engine) ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-replace-with-anthropic-key
# VRAELIS_LLM_API_KEY=                                 # optional; overrides ANTHROPIC_API_KEY for checks
# VRAELIS_EVAL_MODEL=claude-sonnet-4-6                 # optional model override

# ── Email (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=re_replace-with-resend-api-key
RESEND_FROM_EMAIL=Vraelis <hello@vraelis.com>

# ── Stripe ───────────────────────────────────────────────────────
# API keys: dashboard.stripe.com -> Developers -> API keys
STRIPE_SECRET_KEY=sk_live_replace-with-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace-with-stripe-publishable-key   # safe to expose
# Webhook signing secret: Developers -> Webhooks -> your endpoint
STRIPE_WEBHOOK_SECRET=whsec_replace-with-webhook-signing-secret
# STRIPE_VRAELIS_WEBHOOK_SECRET=whsec_...              # optional second endpoint secret
# Plan prices: each plan needs a monthly + yearly price in Stripe. WITHOUT these,
# /api/v/subscribe returns 503 and the plans page renders every plan as "Coming soon".
STRIPE_PRICE_STARTER_MONTHLY=price_replace
STRIPE_PRICE_STARTER_YEARLY=price_replace
STRIPE_PRICE_CREATOR_MONTHLY=price_replace
STRIPE_PRICE_CREATOR_YEARLY=price_replace
STRIPE_PRICE_PRO_MONTHLY=price_replace
STRIPE_PRICE_PRO_YEARLY=price_replace
STRIPE_PRICE_SCALE_MONTHLY=price_replace
STRIPE_PRICE_SCALE_YEARLY=price_replace
# Team seats (per-seat; Stripe handles quantity)
STRIPE_TEAM_SEAT_PRICE_ID=price_replace
STRIPE_TEAM_SEAT_YEARLY_PRICE_ID=price_replace

# ── Ops ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://vraelis.com               # checkout return_url, share links, webhook links
CRON_SECRET=replace-with-a-long-random-secret          # required to authorize /api/cron/*
ADMIN_EMAILS=you@example.com                           # comma-separated admin allowlist (or VRAELIS_ADMIN)
# SENTRY_DSN=                                           # optional error monitoring

# ── Security-critical vars that were previously undocumented ───────────────
#
# TWILIO_INBOUND_SECRET is now LOAD-BEARING. The SMS and voice webhooks used to skip their auth check
# entirely when it was unset (`if (secret && ...)`), which left them open to the internet while every
# accepted request cost an Anthropic call plus an outbound SMS. They now FAIL CLOSED: if this is not set in
# production, /api/vraelis/sms/inbound and /api/vraelis/sms/voice return 403 and the SMS agent stops
# working. Set it before deploying, and append it to the Twilio webhook URLs as ?secret=<value>.
TWILIO_INBOUND_SECRET=replace-with-a-long-random-secret

# Shared secret for the inbound-email webhook (/api/vraelis/inbound/email). Also fails closed.
INBOUND_SECRET=replace-with-a-long-random-secret

# Google Calendar OAuth (the /api/vraelis/calendar/* flow).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# PayPal. PAYPAL_ENV must be "live" in production; anything else points at sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live

# Salt for the free-grant risk hash. Unset means the hash is unsalted.
FREE_GRANT_RISK_SALT=replace-with-a-long-random-secret

# Session cookie domain. Setting a bare parent domain (.vraelis.com) lets EVERY subdomain read and set the
# session cookie — leave unset unless you specifically need cross-subdomain sessions.
AUTH_COOKIE_DOMAIN=

# PayPal webhook verification. Without this the PayPal webhook cannot verify its transmission signature.
PAYPAL_WEBHOOK_ID=

# 64 hex characters. Encrypts customer-supplied secrets in the preflight vault (lib/preflight/secret-vault.ts)
# and signs the stealth/reviewer tokens. lib/stealth.ts falls back to a HARDCODED literal committed to this
# PUBLIC repository when both this and AUTH_SECRET are unset — set it, then that fallback can be deleted.
VRAELIS_SECRET_KEY=

# Twilio account credentials for outbound SMS/voice.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
