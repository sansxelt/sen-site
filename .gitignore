# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
scripts/__pycache__/

# Tauri updater signing key (NEVER commit)
VRAELIS-updater.key
VRAELIS-updater.key.pub

# Claude Code per-user/local settings (shared project config in
# .claude/settings.json IS committed; only the .local override is not)
.claude/settings.local.json
.claude/scheduled_tasks.lock


.vercel
.env*.local

# Outreach prep output (target data + drafted DMs) and the seen-domain ledger — never commit
outreach-*.csv
outreach-seen.txt
distribution-kit.md

# Local ops/diagnostic tools — machine-specific, and grant-credits writes the prod money ledger
outreach-cron.log
run-outreach-daily.cmd
scripts/whoami.ts
scripts/dbcheck.ts
scripts/grant-credits.ts
scripts/apikey-audit.ts

# Playwright E2E (auth state + reports; never commit sessions)
.auth/
test-results/
playwright-report/
playwright/.cache/

# Local design-review workspace: screenshots and screen recordings produced while verifying a
# redesign. Evidence for a review, not source, and ~16MB per pass.
# Anchored to the repo root: an unanchored "review/" matches a directory of that name at ANY depth, which
# silently excluded the app's own Review route at app/dev-preview/v6/app/review/.
/review/
.playwright-cli/
.playwright/

# Provenance correction backups: complete row exports of production tables.
# Requirement text is customer content and must not enter version control.
ops/backups/
